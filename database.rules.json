        ".validate": "newData.hasChildren(['uid', 'fullName', 'teamRole', 'lat', 'lng', 'accuracy', 'updatedAt', 'sharing']) && newData.child('uid').val() == auth.uid && newData.child('lat').isNumber() && newData.child('lat').val() >= -90 && newData.child('lat').val() <= 90 && newData.child('lng').isNumber() && newData.child('lng').val() >= -180 && newData.child('lng').val() <= 180 && newData.child('accuracy').isNumber() && newData.child('updatedAt').isNumber() && newData.child('sharing').isBoolean()"
